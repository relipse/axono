#!/usr/bin/env bash
#
# Tears Claude Worker — Spawn a Claude Code worker inside a Docker container.
#
# Usage:
#   ./claude-worker --repo <git-url> --task <prompt> [options]
#
# Works on macOS and Linux.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="0.2.0"

# ── Defaults ─────────────────────────────────────────────────────────────────
REPO_URL=""
TASK=""
BRANCH_NAME=""
OUTPUT_DIR="${SCRIPT_DIR}/output"
IMAGE_NAME="claude-worker"
CONTAINER_NAME=""
AUTO_ACCEPT="true"
MODEL=""
REPO_BRANCH=""
MAX_TURNS=""
VERBOSE="false"
DRY_RUN="false"
REBUILD="false"
PUSH="false"
DIFF_TOOL=""
REVIEW="true"            # show accept/reject prompt after run (default: on)
NO_REVIEW="false"
TRANSFER_TO=""           # local repo path to transfer the branch into (via git bundle)
LOCAL_REPO=""            # mount a local repo instead of cloning from a URL

# ── Helpers ──────────────────────────────────────────────────────────────────
usage() {
    cat <<'EOF'
Tears Claude Worker — Run Claude Code tasks in an isolated Docker container

USAGE
    ./claude-worker --repo <url> --task <prompt> [OPTIONS]

REQUIRED (one of --repo or --local-repo)
    --repo    <url>       Git repository URL to clone
    --local-repo <path>   Use a local repo directory (mounted read-only,
                          changes are made on a copy inside the container)
    --task    <prompt>    Task / prompt to give Claude Code

OPTIONS
    --branch  <name>      Name for the new feature branch
                          (default: claude/<slugified-task>)
    --repo-branch <name>  Specific branch to clone from the repo
                          (default: repo default)
    --output  <dir>       Directory to save diffs and logs
                          (default: ./output)
    --image   <name>      Docker image name (default: claude-worker)
    --name    <name>      Container name (default: auto-generated)
    --model   <model>     Claude model to use
    --max-turns <n>       Maximum agentic turns
    --interactive         Prompt user before applying changes
                          (disables auto-accept inside container)
    --no-auto-accept      Alias for --interactive

    --push                Push the new branch to the remote after accepting
    --transfer <path>     Transfer the branch into a local repo via git bundle
                          (no credentials needed — pure local operation)
    --diff-tool <cmd>     Open diffs in an external diff/merge tool
                          (e.g. code, meld, vimdiff, opendiff, kdiff3)
    --no-review           Skip the accept/reject prompt (just save diffs)

    --verbose             Show detailed output
    --dry-run             Show what would be run without executing
    --rebuild             Force rebuild the Docker image
    --version             Print version
    -h, --help            Show this help

ENVIRONMENT
    ANTHROPIC_API_KEY     Required. Your Anthropic API key.

EXAMPLES
    # Basic — auto-accept in container, review + accept/reject after
    ./claude-worker \
        --repo https://github.com/user/myapp.git \
        --task "Add unit tests for the auth module"

    # Review in VS Code, then push if accepted
    ./claude-worker \
        --repo https://github.com/user/myapp.git \
        --task "Fix the memory leak in connection pooling" \
        --diff-tool code --push

    # Review in meld (GUI diff tool)
    ./claude-worker \
        --repo https://github.com/user/myapp.git \
        --task "Refactor auth to use JWT" \
        --diff-tool meld

    # Use a local repo instead of cloning from a URL
    ./claude-worker \
        --local-repo ~/projects/myapp \
        --task "Add input validation to all API endpoints"

    # Transfer branch into your local repo (no credentials needed)
    ./claude-worker \
        --repo https://github.com/user/myapp.git \
        --task "Add CI pipeline" \
        --transfer /path/to/local/myapp

    # Skip review, just save diffs
    ./claude-worker \
        --repo https://github.com/user/myapp.git \
        --task "Add CI pipeline" \
        --no-review

OUTPUT
    After the worker finishes, diffs are saved to:
      output/<run-id>/diffs/summary.txt     Quick overview
      output/<run-id>/diffs/full.patch      Full unified diff
      output/<run-id>/diffs/stat.txt        Diffstat
      output/<run-id>/diffs/per-file/       One patch per file
      output/<run-id>/logs/worker.log       Full session log
      output/<run-id>/run-info.json         Run metadata
      output/<run-id>/run-result.json       Result metadata
EOF
}

log()   { printf "\033[1;34m[tears]\033[0m %s\n" "$*"; }
warn()  { printf "\033[1;33m[tears]\033[0m %s\n" "$*" >&2; }
error() { printf "\033[1;31m[tears]\033[0m %s\n" "$*" >&2; exit 1; }
debug() { [[ "$VERBOSE" == "true" ]] && printf "\033[0;90m[debug]\033[0m %s\n" "$*"; }

slugify() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' '-' | sed 's/^-//;s/-$//' | cut -c1-50
}

check_dependencies() {
    if ! command -v docker &>/dev/null; then
        error "Docker is not installed. Install it from: https://docs.docker.com/get-docker/"
    fi
    if ! docker info &>/dev/null 2>&1; then
        error "Docker daemon is not running. Please start Docker."
    fi
}

build_image() {
    local image="$1"
    local force="${2:-false}"

    if [[ "$force" == "false" ]] && docker image inspect "$image" &>/dev/null 2>&1; then
        debug "Image '$image' already exists, skipping build (use --rebuild to force)"
        return 0
    fi

    log "Building Docker image '$image'..."
    docker build -t "$image" "$SCRIPT_DIR" || error "Docker build failed"
    log "Image built successfully"
}

# ── Detect best available diff tool on this system ───────────────────────────
detect_diff_tool() {
    # Preference order: GUI tools first, then TUI
    local candidates=()
    if [[ "$(uname)" == "Darwin" ]]; then
        candidates=(code meld opendiff kdiff3 vimdiff)
    else
        candidates=(code meld kdiff3 vimdiff)
    fi
    for cmd in "${candidates[@]}"; do
        if command -v "$cmd" &>/dev/null; then
            echo "$cmd"
            return 0
        fi
    done
    echo ""
}

# ── Open diffs in an external tool ───────────────────────────────────────────
open_in_diff_tool() {
    local tool="$1"
    local patch_dir="$2"
    local full_patch="${patch_dir}/full.patch"

    if ! command -v "$tool" &>/dev/null; then
        warn "Diff tool '$tool' not found in PATH, falling back to less"
        less "$full_patch"
        return
    fi

    log "Opening diffs in: $tool"

    case "$tool" in
        code)
            # VS Code: open each per-file patch, or the full patch
            if [[ -d "${patch_dir}/per-file" ]] && ls "${patch_dir}/per-file/"*.patch &>/dev/null 2>&1; then
                code --diff "${patch_dir}/per-file/"*.patch 2>/dev/null || code "$full_patch"
            else
                code "$full_patch"
            fi
            ;;
        meld|kdiff3|opendiff)
            # GUI merge tools — show the full patch
            "$tool" "$full_patch" &
            wait $! 2>/dev/null || true
            ;;
        vimdiff|nvim|vim)
            # Terminal diff — show full patch in a pager-like view
            "${tool}" "$full_patch"
            ;;
        *)
            # Generic: just pass the patch file to the tool
            "$tool" "$full_patch"
            ;;
    esac
}

# ── Accept / Reject prompt ───────────────────────────────────────────────────
prompt_review() {
    local run_output="$1"
    local patch_file="${run_output}/diffs/full.patch"
    local stat_file="${run_output}/diffs/stat.txt"

    echo ""
    log "═══════════════════════════════════════════════════════"
    log " REVIEW: Changes produced by Tears Claude Worker"
    log "═══════════════════════════════════════════════════════"
    echo ""

    # Show diffstat
    if [[ -f "$stat_file" ]] && [[ -s "$stat_file" ]]; then
        cat "$stat_file"
        echo ""
    fi

    # Show a compact preview (first 60 lines of the diff)
    if [[ -f "$patch_file" ]] && [[ -s "$patch_file" ]]; then
        local total_lines
        total_lines=$(wc -l < "$patch_file")
        log "Diff preview (${total_lines} total lines):"
        echo "────────────────────────────────────────────────────────"
        head -60 "$patch_file"
        if [[ "$total_lines" -gt 60 ]]; then
            echo "  ... ($(( total_lines - 60 )) more lines)"
        fi
        echo "────────────────────────────────────────────────────────"
    fi

    echo ""
    while true; do
        printf "\033[1;36m[tears]\033[0m [a]ccept / [r]eject / [v]iew diff / [d]iff tool / [p]ush / [t]ransfer: "
        read -r choice </dev/tty
        case "$choice" in
            a|accept|A|y|yes)
                log "Changes accepted."
                echo "accepted" > "${run_output}/decision.txt"
                return 0
                ;;
            r|reject|R|n|no)
                log "Changes rejected."
                echo "rejected" > "${run_output}/decision.txt"
                return 1
                ;;
            v|view|V)
                less "$patch_file" </dev/tty
                ;;
            d|diff|D)
                local tool="$DIFF_TOOL"
                if [[ -z "$tool" ]]; then
                    tool="$(detect_diff_tool)"
                fi
                if [[ -n "$tool" ]]; then
                    open_in_diff_tool "$tool" "${run_output}/diffs"
                else
                    warn "No diff tool found. Showing in less..."
                    less "$patch_file" </dev/tty
                fi
                ;;
            p|push|P)
                log "Changes accepted + pushing."
                echo "accepted+pushed" > "${run_output}/decision.txt"
                PUSH="true"
                return 0
                ;;
            t|transfer|T)
                if [[ -z "$TRANSFER_TO" ]]; then
                    printf "  Enter local repo path: "
                    read -r TRANSFER_TO </dev/tty
                fi
                log "Changes accepted + transferring."
                echo "accepted+transferred" > "${run_output}/decision.txt"
                return 0
                ;;
            *)
                echo "  Please enter: a(ccept), r(eject), v(iew), d(iff tool), p(ush), or t(ransfer)"
                ;;
        esac
    done
}

# ── Push branch to remote (runs a second container) ─────────────────────────
push_branch() {
    local run_output="$1"
    local repo_url="$2"
    local branch="$3"

    log "Pushing branch '$branch' to remote..."

    # Re-use the same image to push from within a container
    # We pass the repo bundle from the first run to avoid re-cloning
    docker run --rm \
        --name "claude-worker-push-$$" \
        -e "REPO_URL=${repo_url}" \
        -e "BRANCH_NAME=${branch}" \
        -e "REPO_BRANCH=${REPO_BRANCH:-}" \
        -e "PUSH_MODE=true" \
        -v "${run_output}:/output" \
        "$IMAGE_NAME" 2>&1 | tee -a "${run_output}/logs/push.log" || {
            warn "Push failed. See: ${run_output}/logs/push.log"
            return 1
        }

    log "Branch '${branch}' pushed successfully."
}

# ── Transfer branch to local repo (via git bundle, no credentials) ───────────
transfer_branch() {
    local run_output="$1"
    local target_repo="$2"
    local branch="$3"
    local bundle="${run_output}/repo.bundle"

    if [[ ! -f "$bundle" ]]; then
        error "No git bundle found at $bundle. Cannot transfer."
    fi

    if [[ ! -d "$target_repo/.git" ]]; then
        error "'$target_repo' is not a git repository."
    fi

    log "Transferring branch '$branch' into $target_repo ..."

    # Add the bundle as a temporary remote, fetch the branch, remove the remote
    (
        cd "$target_repo"
        git remote add claude-worker-bundle "$bundle" 2>/dev/null || \
            git remote set-url claude-worker-bundle "$bundle"
        git fetch claude-worker-bundle "$branch" 2>&1
        git branch "$branch" "claude-worker-bundle/$branch" 2>&1 || \
            git branch -f "$branch" "claude-worker-bundle/$branch" 2>&1
        git remote remove claude-worker-bundle 2>&1
    ) || {
        warn "Transfer failed. You can manually import with:"
        warn "  cd $target_repo && git bundle unbundle $bundle"
        return 1
    }

    log "Branch '$branch' is now available in $target_repo"
    log "  git -C $target_repo checkout $branch"
}

# ── Parse arguments ──────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)         REPO_URL="$2";       shift 2 ;;
        --local-repo)   LOCAL_REPO="$2";     shift 2 ;;
        --task)         TASK="$2";           shift 2 ;;
        --branch)       BRANCH_NAME="$2";    shift 2 ;;
        --repo-branch)  REPO_BRANCH="$2";    shift 2 ;;
        --output)       OUTPUT_DIR="$2";     shift 2 ;;
        --image)        IMAGE_NAME="$2";     shift 2 ;;
        --name)         CONTAINER_NAME="$2"; shift 2 ;;
        --model)        MODEL="$2";          shift 2 ;;
        --max-turns)    MAX_TURNS="$2";      shift 2 ;;
        --interactive|--no-auto-accept) AUTO_ACCEPT="false"; shift ;;
        --push)         PUSH="true";         shift ;;
        --transfer)     TRANSFER_TO="$2";    shift 2 ;;
        --diff-tool)    DIFF_TOOL="$2";      shift 2 ;;
        --no-review)    NO_REVIEW="true";    shift ;;
        --verbose)      VERBOSE="true";      shift ;;
        --dry-run)      DRY_RUN="true";      shift ;;
        --rebuild)      REBUILD="true";      shift ;;
        --version)      echo "Tears Claude Worker $VERSION"; exit 0 ;;
        -h|--help)      usage; exit 0 ;;
        *)              error "Unknown option: $1" ;;
    esac
done

# ── Validate ─────────────────────────────────────────────────────────────────
[[ -z "$REPO_URL" ]] && [[ -z "$LOCAL_REPO" ]] && error "Missing required option: --repo <url> or --local-repo <path>"
[[ -z "$TASK" ]] && error "Missing required option: --task <prompt>"

# Validate local repo if specified
if [[ -n "$LOCAL_REPO" ]]; then
    LOCAL_REPO="$(cd "$LOCAL_REPO" 2>/dev/null && pwd)" || error "Path '$LOCAL_REPO' does not exist"
    [[ -d "$LOCAL_REPO/.git" ]] || error "'$LOCAL_REPO' is not a git repository"
fi

if [[ -z "${ANTHROPIC_API_KEY:-}" ]]; then
    error "ANTHROPIC_API_KEY environment variable is not set"
fi

# Derive branch name if not given
if [[ -z "$BRANCH_NAME" ]]; then
    BRANCH_NAME="claude/$(slugify "$TASK")"
fi

# Derive container name if not given
if [[ -z "$CONTAINER_NAME" ]]; then
    CONTAINER_NAME="claude-worker-$(date +%s)-$$"
fi

# Create run-specific output directory
RUN_ID="$(date +%Y%m%d-%H%M%S)-$$"
RUN_OUTPUT_DIR="${OUTPUT_DIR}/${RUN_ID}"
mkdir -p "${RUN_OUTPUT_DIR}/diffs" "${RUN_OUTPUT_DIR}/logs"

# ── Preflight ────────────────────────────────────────────────────────────────
check_dependencies
build_image "$IMAGE_NAME" "$REBUILD"

# ── Assemble docker run command ──────────────────────────────────────────────
DOCKER_ARGS=(
    docker run
    --rm
    --name "$CONTAINER_NAME"
    -e "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}"
    -e "TASK=${TASK}"
    -e "BRANCH_NAME=${BRANCH_NAME}"
    -e "AUTO_ACCEPT=${AUTO_ACCEPT}"
    -v "${RUN_OUTPUT_DIR}:/output"
)

# Either clone from URL or mount local repo (read-only)
if [[ -n "$LOCAL_REPO" ]]; then
    DOCKER_ARGS+=(-v "${LOCAL_REPO}:/source:ro" -e "LOCAL_REPO=/source")
else
    DOCKER_ARGS+=(-e "REPO_URL=${REPO_URL}")
fi

[[ -n "$REPO_BRANCH" ]]    && DOCKER_ARGS+=(-e "REPO_BRANCH=${REPO_BRANCH}")
[[ -n "$MODEL" ]]          && DOCKER_ARGS+=(-e "CLAUDE_MODEL=${MODEL}")
[[ -n "$MAX_TURNS" ]]      && DOCKER_ARGS+=(-e "MAX_TURNS=${MAX_TURNS}")
[[ "$VERBOSE" == "true" ]] && DOCKER_ARGS+=(-e "VERBOSE=true")

# Interactive mode needs a tty
if [[ "$AUTO_ACCEPT" == "false" ]]; then
    DOCKER_ARGS+=(-it)
fi

DOCKER_ARGS+=("$IMAGE_NAME")

# ── Execute ──────────────────────────────────────────────────────────────────
log "Starting Tears Claude Worker"
if [[ -n "$LOCAL_REPO" ]]; then
    log "  Repo:     $LOCAL_REPO (local)"
else
    log "  Repo:     $REPO_URL"
fi
log "  Task:     $TASK"
log "  Branch:   $BRANCH_NAME"
log "  Output:   $RUN_OUTPUT_DIR"
log "  Mode:     $([ "$AUTO_ACCEPT" = "true" ] && echo "auto-accept" || echo "interactive")"
[[ -n "$MODEL" ]]     && log "  Model:    $MODEL"
[[ -n "$DIFF_TOOL" ]] && log "  DiffTool: $DIFF_TOOL"
[[ "$PUSH" == "true" ]] && log "  Push:     enabled"

if [[ "$DRY_RUN" == "true" ]]; then
    log "[dry-run] Would execute:"
    printf "  %s\n" "${DOCKER_ARGS[@]}"
    exit 0
fi

# Save run metadata
cat > "${RUN_OUTPUT_DIR}/run-info.json" <<INFOJSON
{
  "run_id": "${RUN_ID}",
  "repo_url": "${REPO_URL:-}",
  "local_repo": "${LOCAL_REPO:-}",
  "task": $(printf '%s' "$TASK" | jq -Rs .),
  "branch_name": "${BRANCH_NAME}",
  "auto_accept": ${AUTO_ACCEPT},
  "push": ${PUSH},
  "diff_tool": $(printf '%s' "${DIFF_TOOL}" | jq -Rs .),
  "started_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "image": "${IMAGE_NAME}",
  "container": "${CONTAINER_NAME}"
}
INFOJSON

# Run the container, teeing output to a log file
"${DOCKER_ARGS[@]}" 2>&1 | tee "${RUN_OUTPUT_DIR}/logs/worker.log" || true

# ── Post-run ─────────────────────────────────────────────────────────────────
PATCH_FILE="${RUN_OUTPUT_DIR}/diffs/full.patch"
HAS_CHANGES="false"

if [[ -f "$PATCH_FILE" ]] && [[ -s "$PATCH_FILE" ]]; then
    HAS_CHANGES="true"
    DIFF_LINES=$(wc -l < "$PATCH_FILE")
    log ""
    log "═══════════════════════════════════════════════════════"
    log " Tears Worker finished — ${DIFF_LINES} lines of changes"
    log "═══════════════════════════════════════════════════════"
else
    warn "No diffs generated. Check: ${RUN_OUTPUT_DIR}/logs/worker.log"
    exit 0
fi

# ── Open in diff tool if specified ───────────────────────────────────────────
if [[ -n "$DIFF_TOOL" ]] && [[ "$HAS_CHANGES" == "true" ]]; then
    open_in_diff_tool "$DIFF_TOOL" "${RUN_OUTPUT_DIR}/diffs"
fi

# ── Accept / Reject prompt ───────────────────────────────────────────────────
if [[ "$NO_REVIEW" == "false" ]] && [[ "$HAS_CHANGES" == "true" ]]; then
    if prompt_review "$RUN_OUTPUT_DIR"; then
        # Accepted
        if [[ -n "$TRANSFER_TO" ]]; then
            transfer_branch "$RUN_OUTPUT_DIR" "$TRANSFER_TO" "$BRANCH_NAME"
        fi
        if [[ "$PUSH" == "true" ]]; then
            push_branch "$RUN_OUTPUT_DIR" "$REPO_URL" "$BRANCH_NAME"
        fi
    else
        # Rejected
        log "Changes saved at: ${RUN_OUTPUT_DIR}/diffs/full.patch"
        log "You can still review or apply them later."
        exit 0
    fi
elif [[ "$HAS_CHANGES" == "true" ]]; then
    # --no-review mode: run transfer and push if requested
    if [[ -n "$TRANSFER_TO" ]]; then
        transfer_branch "$RUN_OUTPUT_DIR" "$TRANSFER_TO" "$BRANCH_NAME"
    fi
    if [[ "$PUSH" == "true" ]]; then
        push_branch "$RUN_OUTPUT_DIR" "$REPO_URL" "$BRANCH_NAME"
    fi
fi

# ── Final summary ────────────────────────────────────────────────────────────
echo ""
log "═══════════════════════════════════════════════════════"
log " Patch:   ${RUN_OUTPUT_DIR}/diffs/full.patch"
log " Summary: ${RUN_OUTPUT_DIR}/diffs/summary.txt"
log " Stat:    ${RUN_OUTPUT_DIR}/diffs/stat.txt"
log " Log:     ${RUN_OUTPUT_DIR}/logs/worker.log"
log "═══════════════════════════════════════════════════════"
log ""
log "Apply to your local repo:"
log "  cd /path/to/your/repo"
log "  git apply ${RUN_OUTPUT_DIR}/diffs/full.patch"
