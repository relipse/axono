class ClaudeWorkerApp:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Claude Worker")
        self.root.geometry("860x780")
        self.root.minsize(720, 620)

        style = ttk.Style()
        for theme in ("clam", "aqua", "alt"):
            if theme in style.theme_names():
                style.theme_use(theme)
                break

        main = ttk.Frame(self.root, padding=8)
        main.pack(fill=tk.BOTH, expand=True)

        # Header
        hdr = ttk.Frame(main)
        hdr.pack(fill=tk.X, pady=(0, 6))
        ttk.Label(hdr, text="Claude Worker", font=("TkDefaultFont", 16, "bold")).pack(side=tk.LEFT)
        ttk.Label(hdr, text="Run & manage Claude Code tasks in Docker", foreground="gray").pack(side=tk.LEFT, padx=(10, 0))

        # Tabs
        notebook = ttk.Notebook(main)
        notebook.pack(fill=tk.BOTH, expand=True)

        worker_frame = ttk.Frame(notebook)
        manager_frame = ttk.Frame(notebook)
        notebook.add(worker_frame, text="  New Task  ")
        notebook.add(manager_frame, text="  Manager  ")

        self.worker_tab = WorkerTab(worker_frame, self)
        self.manager_tab = ManagerTab(manager_frame, self)

        # Status bar
        self.status_var = tk.StringVar(value="Ready")
        ttk.Label(main, textvariable=self.status_var, relief=tk.SUNKEN, anchor=tk.W).pack(fill=tk.X, pady=(4, 0))

    def set_status(self, text: str):
        self.root.after(0, lambda: self.status_var.set(text))

    def run(self):
        self.root.mainloop()


def main():
    ClaudeWorkerApp().run()


if __name__ == "__main__":
    main()
